# Local development uses SQLite. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/clothed
DATABASE_URL=sqlite:///./clothed.db
UPLOAD_DIR=./uploads
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment
JWT_EXPIRE_MINUTES=10080

# AI provider: ollama (default/local) or openai (cloud)
AI_PROVIDER=ollama

# Ollama — local vision model. Start Ollama and pull the model first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Optional OpenAI provider. Only required when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.5
